# Everything here is regenerated by `python quiz/build/rebuild.py`.
# Keeping generated files out of git is what makes parallel branches mergeable:
# questions.json (3.5 MB) and quiz.html (~2.1 MB; figures live beside it in
# quiz/images/ as plain PNGs, not inlined as base64) would otherwise conflict on
# every branch that runs a rebuild, in files nobody edits.

# --- deliverables (rebuild.py / build_quiz.py) ---
quiz/questions.json
quiz/quiz.html
quiz/images/

# --- parse intermediates (parse2.py / parse_book2.py) ---
quiz/build/bank.json
quiz/build/book_parsed2.json

# --- figure crops (figures2.py / book_figures.py) ---
quiz/build/figs/
quiz/build/figs_book/
quiz/build/figs_index.json
quiz/build/figs_book_index.json

# --- per-topic work packets (make_packets.py); the *.md briefs beside them are hand-written ---
quiz/build/work/packet_*.json

# --- python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- transient run state ---
queue/.inflight

# --- harness / os ---
.claude/scheduled_tasks.lock
.claude/settings.local.json
desktop.ini
Thumbs.db

# --- PII: personal contact-info drafts (name, phone, personal email, address) ---
emails/

# --- copyrighted source scans: HRS priručnik + third-party book; credited, not redistributed ---
docs/
